# ==============================================================================
# STOCKFLOW - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local to Git.

# 1. Database Connection (Aiven PostgreSQL)
# Replace with your actual Aiven PostgreSQL connection URI:
# Format: postgres://<user>:<password>@<host>:<port>/STOCKFLOW?sslmode=require
DATABASE_URL=postgres://avnadmin:your_password@your-host.aivencloud.com:port/STOCKFLOW?sslmode=require

# 2. Database Schema (Default: stockflow)
DB_SCHEMA=stockflow

# 3. Optional Aiven CA Certificate (Base64 encoded or string content)
# If your Aiven PostgreSQL instance requires a custom CA certificate, paste it here:
# AIVEN_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# 4. JWT & Session Security Secret
# Generate a strong 32+ character random string:
JWT_SECRET=super_secret_stockflow_jwt_key_replace_with_random_bytes_in_production_32char

# 5. Application Environment
NODE_ENV=development
